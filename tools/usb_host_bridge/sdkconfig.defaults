CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# The VCP drivers report open failures with C++ exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# Logs on UART0 (the DevKit "UART"/"COM" port). The native USB port is the
# USB host port, so the USB-Serial-JTAG console must not be used.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# 1ms tick: the UART polling loops use millisecond timeouts
CONFIG_FREERTOS_HZ=1000
